{
  "name": "@jolt/protocol",
  "version": "0.1.0",
  "description": "Shared wire protocol, schemas, permissions and identity primitives for Jolt.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
