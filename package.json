{
  "name": "@getjolt/protocol",
  "version": "0.1.0",
  "description": "The Jolt wire protocol: schemas, permissions, IDs and federated identity, shared by servers and clients.",
  "keywords": [
    "jolt",
    "chat",
    "federation",
    "protocol",
    "discord-alternative"
  ],
  "license": "MIT",
  "author": "The Jolt contributors",
  "homepage": "https://github.com/GetJolt/protocol#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GetJolt/protocol.git"
  },
  "bugs": {
    "url": "https://github.com/GetJolt/protocol/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "PROTOCOL.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@noble/ed25519": "^3.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
